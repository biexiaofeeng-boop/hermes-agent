# Hermes eval profile model template for DMX.
# Copy to $HERMES_HOME/config.yaml, then replace placeholders locally.
# Keep secrets in $HERMES_HOME/.env, not in this file.

model:
  provider: custom:dmx
  default: gpt-5.4
  context_length: 1048576
  max_tokens: 8192
  temperature: 0.7
  supports_vision: true

providers:
  dmx:
    name: DMX
    api: https://www.dmxapi.cn/v1
    key_env: DMX_API_KEY
    default_model: gpt-5.4
    transport: chat_completions
    discover_models: false
    models:
      gpt-5.4:
        context_length: 1048576
        supports_vision: true

agent:
  image_input_mode: auto

skills:
  external_dirs:
    - ~/1data/Chimera-Projs/chimera-skills
  disabled:
    - chimera-prod-release-ops
  platform_disabled:
    telegram:
      - chimera-prod-release-ops
